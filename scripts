import pandas as pd
import numpy as np

dados = pd.read_csv("dados.csv")

print("Informações do DataFrame:")
print(dados.info())
print("\nPrimeiras linhas:")
print(dados.head())
print("\nÚltimas linhas:")
print(dados.tail())

dados_limpos = dados.copy()

dados_limpos['Calories'].fillna(0, inplace=True)
print("\nDados depois de preencher Calories com 0:")
print(dados_limpos)

dados_limpos['Date'].fillna('1900/01/01', inplace=True)
print("\nDados depois de preencher Date com 1900/01/01:")
print(dados_limpos)

dados_limpos['Date'].replace('1900/01/01', np.nan, inplace=True)

try:
    dados_limpos['Date'] = pd.to_datetime(dados_limpos['Date'], format='%Y/%m/%d')
except:
    print("Erro ao converter datas com formato errado")

dados_limpos['Date'] = dados_limpos['Date'].replace('20201226', pd.to_datetime('2020-12-26'))

dados_limpos['Date'] = pd.to_datetime(dados_limpos['Date'], errors='coerce')

print("\nColuna Date depois de limpar tudo:")
print(dados_limpos)

dados_limpos.dropna(subset=['Date'], inplace=True)

print("\nDataFrame final, com os dados prontos:")
print(dados_limpos)
